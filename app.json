{
  "expo": {
    "name": "Oson Uy",
    "slug": "oson-uy",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "osonuy",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "icon": "./assets/osonuy-logo-mini-removedbg.png",
    "splash": {
      "image": "./assets/osonuy-logo-mini-removedbg.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "dark": {
        "image": "./assets/osonuy-logo-mini-removedbg.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.osonuy.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.osonuy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/osonuy-logo-mini-removedbg.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://api.oson-uy.uz",
      "heroVideoUrl": "",
      "eas": {
        "projectId": "b30a68b1-e29e-4779-b817-dc60054440a1"
      }
    },
    "owner": "sardor-sofr-solutions"
  }
}
